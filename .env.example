# Copie para .env e preencha os valores

# Shopify (obter com: npm run shopify app env show)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_metaobject_definitions,write_metaobjects,write_products

# URL pública do app (Render: https://seu-app.onrender.com)
SHOPIFY_APP_URL=

# Postgres — Render injeta automaticamente em produção
# Local com docker compose: postgresql://papirar:papirar@localhost:5432/papirar
DATABASE_URL=

NODE_ENV=development