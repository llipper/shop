# Copie para .env e preencha os valores

# Loja Shopify (domínio myshopify.com)
SHOP_STORE_DOMAIN=papirar.myshopify.com

# URL pública do seu site (Vercel) — configure o mesmo link no logo do checkout Shopify
PUBLIC_STOREFRONT_URL=https://papirar-teste.vercel.app

# Storefront API — Admin Shopify → Configurações → Apps → Desenvolver apps
# → seu app → Configuração → Token da API Storefront
# Escopos necessários: unauthenticated_read_product_listings,
# unauthenticated_read_product_inventory, unauthenticated_write_checkouts,
# unauthenticated_write_customers (pré-preencher e-mail no checkout)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Escopos adicionais para conta do cliente e newsletter:
# unauthenticated_read_customers, unauthenticated_write_customers

# Catálogo mock só em dev local (nunca use true em produção)
ALLOW_MOCK_CATALOG=false

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Credenciais de teste ou produção (Access Token + Public Key)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Shopify Admin API — app customizado no admin (não é o token Storefront)
# Escopos: write_draft_orders, read_draft_orders, write_orders
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Contato (Resend) — https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=suporte@rouhi.com.br
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Opcional: só se for usar o app admin embutido (/app) com shopify app dev
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_metaobject_definitions,write_metaobjects,write_products
SHOPIFY_APP_URL=
DATABASE_URL=

NODE_ENV=development