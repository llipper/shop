# Copie para .env e preencha os valores

# Loja Shopify (domínio myshopify.com)
SHOP_STORE_DOMAIN=papirar.myshopify.com

# URL pública do seu site (Vercel) — configure o mesmo link no logo do checkout Shopify
PUBLIC_STOREFRONT_URL=https://seu-app.vercel.app

# Storefront API — Admin Shopify → Configurações → Apps → Desenvolver apps
# → seu app → Configuração → Token da API Storefront
# Escopos necessários: unauthenticated_read_product_listings,
# unauthenticated_read_product_inventory, unauthenticated_write_checkouts
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Opcional: só se for usar o app admin embutido (/app) com shopify app dev
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_metaobject_definitions,write_metaobjects,write_products
SHOPIFY_APP_URL=
DATABASE_URL=

NODE_ENV=development